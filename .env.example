# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# HS256 signing key for JWTs. Generate one with: openssl rand -base64 48
JWT_SECRET=

# Optional — access token lifetime in milliseconds. Defaults to 900000 (15 min) if unset.
# JWT_EXPIRATION_MS=900000

# Optional — refresh token lifetime in milliseconds. Defaults to 604800000 (7 days) if unset.
# JWT_REFRESH_EXPIRATION_MS=604800000
